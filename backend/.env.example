# 数据库配置
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=maintenance_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Milvus 向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_REST_PORT=9091
MILVUS_COLLECTION=knowledge
MILVUS_VECTOR_SIZE=1024

# MinIO 对象存储（Milvus 依赖）
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# DeepSeek API 配置（重要！）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 钉钉开放平台配置（在钉钉开放平台创建企业内部应用后获得）
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_AGENT_ID=your-dingtalk-agent-id
DINGTALK_CORP_ID=your-dingtalk-corp-id
# 企业内部机器人 RobotCode（单聊消息用）
DINGTALK_ROBOT_CODE=your-dingtalk-robot-code
# OAuth2 授权回调地址（需与钉钉后台"登录与分享"配置一致，可用 cpolar 内网穿透域名）
DINGTALK_REDIRECT_URI=https://your-domain/api/v1/dingtalk/callback
DINGTALK_MOCK_MODE=false
# Stream 模式开关：true 用长连接接收事件（推荐，无需公网回调地址）；false 走 HTTP 回调
DINGTALK_STREAM_MODE=true
# 请假 OA 审批模板 processCode（从钉钉后台 OA 模板"查看编码"复制）
DINGTALK_LEAVE_PROCESS_CODE=PROC-your-process-code

# 追踪后端配置（支持 ragflow / langfuse / local）
TRACING_BACKEND=local
RAGFLOW_HOST=http://localhost:9380
RAGFLOW_API_KEY=ragflow-your-api-key
RAGFLOW_TRACES_DATASET=ticket_traces
RAGFLOW_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=False

# 应用配置
APP_NAME=企业维修知识管理系统
APP_VERSION=1.0.0
DEBUG=True
BACKEND_PORT=8000

# JWT 配置
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log